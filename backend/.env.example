# ─── Server ───────────────────────────────────────────────
PORT=4000

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# e.g. https://pelaminan.id,https://www.pelaminan.id,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@postgres:5432/wedding_db

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# ─── File uploads ─────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ─── Custom domain DNS ────────────────────────────────────
# Your EC2 / server public IP — shown to users in DNS setup instructions
SERVER_IP=

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
