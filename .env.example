# ─── Frontend ───────────────────────────────────────────────
# URL of the backend API as seen from the browser.
# Leave empty "" when behind Nginx reverse proxy (Nginx handles routing)
NEXT_PUBLIC_API_URL=
# Google Maps embed API key (optional — for ceremony location map)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# ─── Backend ────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# Database (must match docker-compose.yml postgres service)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wedding
DB_USER=wedding
DB_PASSWORD=wedding_secret

# Redis (must match docker-compose.yml redis service)
REDIS_URL=redis://redis:6379

# JWT secret for auth tokens — generate a strong random string
# Use: openssl rand -base64 32
JWT_SECRET=replace_with_random_string

# App URLs
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Upload directory (inside the backend container)
UPLOAD_DIR=/uploads
